generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== SETTINGS ====================

model Settings {
  id              String   @id @default("default")
  businessName    String   @default("My Business")
  businessDesc    String   @default("")
  welcomeMessage  String   @default("Hello! How can I help you today?")
  tone            String   @default("friendly")
  language        String   @default("auto")
  aiProvider      String   @default("openai")
  aiModel         String   @default("gpt-4o-mini")
  aiApiKey        String   @default("")
  aiApiKeySecondary String  @default("")
  fallbackProvider  String   @default("")
  fallbackModel     String   @default("")
  fallbackApiKey    String   @default("")
  maxTokens       Int      @default(2048)
  temperature     Float    @default(0.7)
  elevenLabsKey   String   @default("")
  elevenLabsVoice String   @default("")
  twilioSid       String   @default("")
  twilioToken     String   @default("")
  twilioPhone     String   @default("")
  smtpHost        String   @default("")
  smtpPort        Int      @default(587)
  smtpUser        String   @default("")
  smtpPass        String   @default("")
  smtpFrom        String   @default("")
  imapHost        String   @default("")
  imapPort        Int      @default(993)
  imapUser        String   @default("")
  imapPass        String   @default("")
  whatsappMode    String   @default("web")
  whatsappApiKey      String   @default("")
  whatsappPhone       String   @default("")
  telegramBotToken    String   @default("")
  adminTelegramChatId String   @default("")
  externalAiEnabled      Boolean  @default(false)
  externalAiProvider     String   @default("groq")
  externalAiModel        String   @default("openai/gpt-oss-120b")
  externalAiApiKey       String   @default("")
  externalAiPrompt       String   @default("Tu es un assistant d'information pour les enseignants de l'éducation nationale au Maroc (وزارة التربية الوطنية والتعليم الأولي والرياضة).\n1. Cadre d'intervention : Réponds uniquement dans le cadre des lois, statuts et pratiques du ministère de l'Éducation nationale au Maroc.\n2. Questions pédagogiques : Fournis des réponses claires, structurées et bienveillantes en arabe ou en français selon la langue de la question.\n3. Questions administratives ou juridiques : Si tu n'es pas certain à 100% du texte de loi officiel marocain en vigueur, ne spécule jamais. Mentionne brièvement les principes généraux et termine par la formule de précaution.")
  externalAiAuditPolicy  String   @default("always")
  scopeWhitelist         Json?    @default("[]")
  createdAt           DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== AUTH ====================

model Admin {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  name        String   @default("Admin")
  role        String   @default("admin")
  permissions Json?    // Per-module access: { "forum": "write", "campaigns": "read", "settings": "none" }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== KNOWLEDGE BASE ====================

model Category {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  icon        String           @default("folder")
  color       String           @default("#4A7C9B")
  sortOrder   Int              @default(0)
  entries     KnowledgeEntry[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Office {
  id              String   @id @default(uuid())
  sourceId        Int      @unique
  level           String
  name            String
  region          String   @default("")
  province        String   @default("")
  parentOffice    String   @default("")
  secretary      String   @default("")
  secretaryPhone String   @default("")
  treasurer      String   @default("")
  treasurerPhone String   @default("")
  foundedAt      String   @default("")
  renewalAt      String   @default("")
  renewalDuration String  @default("")
  sourceUpdatedAt String  @default("")
  sourceUrl      String
  isActive       Boolean  @default(true)
  squeletteVille String?  // Consonantal skeleton of city/province name for robust matching
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([level])
  @@index([region])
  @@index([province])
  @@index([isActive])
  @@index([squeletteVille])
}

model CannedResponse {
  id         String   @id @default(uuid())
  title      String
  content    String
  category   String   @default("General")
  shortcut   String   @default("")
  isActive   Boolean  @default(true)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model KnowledgeEntry {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  content    String
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

// ==================== TEAM ====================

model Department {
  id          String       @id @default(uuid())
  name        String
  description String       @default("")
  email       String       @default("")
  members     TeamMember[]
  tickets     Ticket[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamMember {
  id           String     @id @default(uuid())
  name         String
  email        String
  phone        String     @default("")
  role         String     @default("member")
  expertise    String     @default("")
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isAvailable  Boolean    @default(true)
  tickets      Ticket[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId])
}

// ==================== CONVERSATIONS ====================

model Conversation {
  id              String            @id @default(uuid())
  channel         String
  customerName    String            @default("Unknown")
  customerContact String            @default("")
  customerId      String?
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          String            @default("active")
  satisfaction    Int?
  summary         String            @default("")
  metadata        Json              @default("{}")
  messages        Message[]
  tickets         Ticket[]
  tags            ConversationTag[]
  notes           InternalNote[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([channel])
  @@index([status])
  @@index([customerContact])
  @@index([channel, status])
  @@index([createdAt])
  @@index([customerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  mediaType      String?
  mediaUrl       String?
  toolCalls      Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
}

// ==================== TICKETS ====================

model Ticket {
  id             String        @id @default(uuid())
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     TeamMember?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  title          String
  description    String
  status         String        @default("open")
  priority       String        @default("medium")
  resolution     String        @default("")
  type           String        @default("ticket") // "ticket" | "suggestion"
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([type])
}

// ==================== TAGS ====================

model Tag {
  id            String            @id @default(uuid())
  name          String            @unique
  color         String            @default("#4A7C9B")
  conversations ConversationTag[]
  createdAt     DateTime          @default(now())
}

model ConversationTag {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
}

// ==================== CALL LOGS ====================

model CallLog {
  id        String   @id @default(uuid())
  callSid   String   @unique
  from      String
  to        String
  duration  Int      @default(0)
  status    String   @default("initiated")
  recording String?
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== CHANNELS ====================

model Channel {
  id        String   @id @default(uuid())
  type      String   @unique
  isActive  Boolean  @default(false)
  config    Json     @default("{}")
  status    String   @default("disconnected")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== SCHEDULES ====================

model Schedule {
  id           String @id @default(uuid())
  teamMemberId String
  dayOfWeek    Int
  startTime    String
  endTime      String

  @@index([teamMemberId])
  @@index([dayOfWeek])
}

// ==================== WEBHOOKS ====================

model Webhook {
  id          String            @id @default(uuid())
  name        String
  description String            @default("")
  url         String
  method      String            @default("POST")
  headers     Json              @default("{}")
  isActive    Boolean           @default(true)
  triggerOn   String
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  webhookId   String
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event       String
  payload     Json
  status      String    @default("pending") // pending, delivered, failed
  statusCode  Int?
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([webhookId])
  @@index([status, nextRetryAt])
}

// ==================== ACTIVITY LOG ====================

model ActivityLog {
  id          String   @id @default(uuid())
  action      String   // conversation.created, ticket.assigned, settings.updated, etc.
  entity      String   // conversation, ticket, settings, knowledge, team
  entityId    String?
  description String
  userId      String?
  userName    String   @default("System")
  metadata    Json     @default("{}")
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

// ==================== SLA RULES ====================

model SLARule {
  id                String   @id @default(uuid())
  name              String
  description       String   @default("")
  channel           String   @default("all") // all, whatsapp, email, phone
  priority          String   @default("all") // all, low, medium, high, urgent
  firstResponseMins Int      @default(30)
  resolutionMins    Int      @default(480)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==================== CUSTOMERS ====================

model Customer {
  id            String         @id @default(uuid())
  name          String
  email         String         @default("")
  phone         String         @default("")
  whatsapp      String         @default("")
  tags          String         @default("") // comma-separated
  isBlocked     Boolean        @default(false)
  notes         CustomerNote[]
  conversations Conversation[]
  metadata      Json           @default("{}")
  firstContact  DateTime       @default(now())
  lastContact   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([email])
  @@index([phone])
  @@index([whatsapp])
  @@index([lastContact])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  authorName String   @default("Admin")
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ==================== AUTOMATION RULES ====================

model AutomationRule {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  type        String   // auto_route, auto_tag, auto_reply, keyword_alert
  isActive    Boolean  @default(true)
  conditions  Json     @default("[]") // [{field, operator, value}]
  actions     Json     @default("[]") // [{type, target, value}]
  priority    Int      @default(0)
  triggerCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== BUSINESS HOURS ====================

model BusinessHours {
  id        String  @id @default("default")
  enabled   Boolean @default(false)
  timezone  String  @default("UTC")
  monday    String  @default("09:00-18:00") // empty = closed
  tuesday   String  @default("09:00-18:00")
  wednesday String  @default("09:00-18:00")
  thursday  String  @default("09:00-18:00")
  friday    String  @default("09:00-18:00")
  saturday  String  @default("")
  sunday    String  @default("")
  offlineMessage String @default("We are currently offline. We will get back to you during business hours.")
}

// ==================== API KEYS ====================

model ApiKey {
  id        String   @id @default(uuid())
  name      String
  key       String   @unique
  isActive  Boolean  @default(true)
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ==================== INTERNAL NOTES ====================

model InternalNote {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  authorName     String       @default("Admin")
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ==================== CAMPAIGNS ====================

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  channel     String   @default("email")
  message     String
  subject     String   @default("")
  segments    Json     @default("[]")
  status      String   @default("draft") // draft, scheduled, running, completed, paused
  scheduledAt DateTime?
  sentCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== FLOWS ====================

model Flow {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  startNodeId String   @default("")
  nodes       Json     @default("[]")
  isActive    Boolean  @default(false)
  triggerCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== WHATSAPP MESSAGE DEDUP ====================
// Cross-worker deduplication table to ensure only one Next.js worker
// processes each incoming WhatsApp message.

model WaMsgDedup {
  key        String   @id
  expiresAt  DateTime

  @@map("wa_msg_dedup")
}

// ==================== MESSAGE FEEDBACK ====================
// Stores user feedback (👍/👎) collected across all channels.
// Used in the Dashboard to identify weak answers and improve the knowledge base.

model MessageFeedback {
  id             String   @id @default(uuid())
  channel        String   // "whatsapp" | "telegram" | "webchat"
  conversationId String?  // linked Conversation.id if available
  messageId      String?  // external message id (WA msg id, Telegram msg id)
  question       String   @default("") // the user question that triggered this response
  rating         String   // "positive" | "negative"
  reviewed       Boolean  @default(false) // marked as reviewed by admin
  createdAt      DateTime @default(now())

  @@index([channel])
  @@index([rating])
  @@index([reviewed])
  @@index([createdAt])
}

// ==================== WHATSAPP GROUP WATCH ====================
// Captures messages from monitored WhatsApp groups in Silent Watch Mode.
// Used in Dashboard to detect emerging topics, FAQs, and grassroots concerns.

model GroupWatchMessage {
  id            String   @id @default(uuid())
  groupJid      String
  groupName     String   @default("")
  senderName    String   @default("")
  senderJid     String   @default("")
  content       String
  isQuestion    Boolean  @default(false)
  topic         String   @default("عام")
  keywords      String[] @default([])
  sentiment     String   @default("neutral")
  starred       Boolean  @default(false)
  convertedToKb Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([groupJid])
  @@index([isQuestion])
  @@index([topic])
  @@index([createdAt])
}

// ==================== ADMINISTRATIVE REQUESTS ====================
// Stores administrative letters and requests generated by the chatbot wizard.
// Each request is linked to a conversation and can be printed or escalated to a ticket.

model AdministrativeRequest {
  id             String   @id @default(uuid())
  conversationId String?  // linked Conversation.id
  channel        String   // whatsapp | telegram | webchat
  type           String   // ta3n_admin | ta3n_movement | demande_docs | conge_maladie | conge_naissance | taklif | libre
  recipientLevel String   @default("province") // province | academie | ministere | member
  fullName       String   @default("")
  grade          String   @default("")
  school         String   @default("")
  province       String   @default("")
  subject        String   @default("") // the user's stated issue / objet
  extraData      Json     @default("{}") // any additional fields by type
  generatedText  String   // the full generated Arabic letter text
  printToken     String   @unique // random token for the public print URL
  status         String   @default("generated") // generated | printed | escalated | closed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([channel])
  @@index([conversationId])
}

model ShortLink {
  id        String   @id @default(uuid())
  slug      String   @unique
  url       String
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([slug])
}

// ==================== FORUM / COLLABORATIVE DISCUSSIONS ====================

model ForumTopic {
  id                String      @id @default(uuid())
  title             String
  promptQuestion    String
  status            String      @default("active") // "active" | "closed"
  channels          String[]    @default(["whatsapp", "telegram"])
  targetAudience    String      @default("manual") // "manual" | "subscribers" | "all"
  targetCustomerIds String[]    @default([])
  moderationMode    Boolean     @default(true)
  subscribersCount  Int         @default(0)
  postsCount        Int         @default(0)
  posts             ForumPost[]
  closedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ForumPost {
  id             String      @id @default(uuid())
  topicId        String
  topic          ForumTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  customerId     String?
  authorName     String      @default("أحد الأساتذة")
  authorContact  String      @default("")
  channel        String      @default("whatsapp")
  content        String
  status         String      @default("pending") // "pending" | "approved" | "broadcasted" | "rejected"
  broadcastCount Int         @default(0)
  broadcastedAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([topicId])
  @@index([status])
  @@index([createdAt])
}

model MenProcessedItem {
  id        String   @id
  url       String
  title     String
  status    String   @default("imported")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model WpProcessedPost {
  wpPostId  Int      @id
  title     String
  url       String?
  status    String   @default("imported")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
