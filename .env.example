# ============================================
# Owly - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# Required variables are marked with [REQUIRED]
# ============================================

# [REQUIRED] PostgreSQL connection string
# In Docker, use service name "db" not "localhost"
DATABASE_URL="postgresql://postgres:postgres@db:5432/owly?schema=public"

# [REQUIRED] Secret key for JWT token signing (use a random 32+ char string)
JWT_SECRET="change-this-to-a-random-secret"

# [REQUIRED] App URL (used for callbacks and webhooks)
# Use https://your-domain.com in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [REQUIRED] Webhook secret for HMAC-SHA256 signatures
WEBHOOK_SECRET="change-this-to-a-random-secret"

# Environment (development | production)
NODE_ENV="production"

# ---- AI Provider (at least one required) ----

# OpenAI API key
OPENAI_API_KEY="sk-your-openai-api-key"

# Anthropic API key (optional, used as fallback)
ANTHROPIC_API_KEY="sk-ant-your-key"

# Groq API key (optional, used as fallback)
GROQ_API_KEY="gsk_your-key"

# OpenRouter API key (optional, used for embeddings)
OPENROUTER_API_KEY="sk-or-v1-your-key"

# ---- WhatsApp Channel ----

# Token used to verify WhatsApp webhook subscriptions
WHATSAPP_VERIFY_TOKEN="change-this-to-a-random-secret"

# Token used to share authenticated links
WHATSAPP_SHARE_TOKEN="change-this-to-a-random-secret"

# API key for internal WhatsApp auth
WHATSAPP_API_KEY="change-this-to-a-random-secret"

# ---- Telegram Channel (optional) ----

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""

# Webhook URL configured with @BotFather
TELEGRAM_WEBHOOK_URL=""

# ---- Phone Channel (Twilio + ElevenLabs - optional) ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
ELEVENLABS_API_KEY=""

# ---- Redis (optional, for queue/cache) ----
REDIS_URL="redis://redis:6379"

# ---- CORS (optional) ----
# Set to allow cross-origin API access (e.g., "https://your-frontend.com")
CORS_ORIGIN=""

# ---- Cookie Security ----
# Set to "true" only in production with HTTPS
COOKIE_SECURE="true"

# ---- Snapshots (auto-configured by install-owly.sh) ----
SNAPSHOT_DIR="/backups/owly"
SNAPSHOT_RETENTION_DAYS="7"

# ---- Internal use ----
NEXTAUTH_SECRET="change-this-to-a-random-secret"
